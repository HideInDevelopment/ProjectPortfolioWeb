{
  "ConnectionStrings": {
    "PortfolioWebDatabase": "Host=<host>;Port=5432;Database=<database>;Username=<username>;Password=<password>"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Authentication": {
    "Issuer": "<issuer>",
    "Audience": "<audience>",
    "SigningKey": "<signing-key-with-sufficient-length>",
    "ExpirationMinutes": 60
  },
  "Features": {
    "ExposeApiDocs": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
